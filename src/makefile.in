# makefile for nauty 2.9
# @configure_input@
RELEASE=@PACKAGE_VERSION@

SHELL=@SHELL@
CC=@CC@
srcdir=@top_srcdir@
CPPFLAGS=@CPPFLAGS@ -I. -I${srcdir}/src
CFLAGS=@CFLAGS@ @MORECFLAGS@
CCC=${CC} ${CPPFLAGS} ${CFLAGS}
LDFLAGS=@LDFLAGS@ @LIBS@
TESTPROGS=@testprogs@
NAUTESTS=@nautests@
EXEEXT=@EXEEXT@

XO=@osuffix@
# CRYPTOLIB=@crypto_lib@
# CRYPTOINC=@crypto_inc@

# Trailing spaces in the following will cause problems

prefix=@prefix@
exec_prefix=@exec_prefix@
bindir=@bindir@
libdir=@libdir@
includedir=@includedir@
pkgconfigdir=@pkgconfigdir@

CYGNOUN=@cygnoun@
top_builddir=..
LIBTOOL=@LIBTOOL@
LTC=${LIBTOOL} --mode=compile ${CCC} -c 
LTL=${LIBTOOL} --mode=link ${CCC} ${CYGNOUN} -rpath ${DESTDIR}${libdir} -release ${RELEASE} ${LDFLAGS}
LTP=${LIBTOOL} --mode=link ${CCC} ${CYGNOUN} ${LDFLAGS}
CCOBJ=${LTC} -o $@

INSTALL=@INSTALL@
INSTALL_DATA=@INSTALL_DATA@
MKDIR_P=@MKDIR_P@

SMALL=-DMAXN=WORDSIZE
S1=-DMAXN=WORDSIZE -DWORDSIZE=16
W1=-DMAXN=WORDSIZE -DWORDSIZE=32
L1=-DMAXN=WORDSIZE -DWORDSIZE=64
Q1=-DMAXN=WORDSIZE -DWORDSIZE=128
S=-DWORDSIZE=16
W=-DWORDSIZE=32
L=-DWORDSIZE=64
Q=-DWORDSIZE=128

GTOOLSH=gtools.h nauty.h naututil.h ${srcdir}/src/nausparse.h ${srcdir}/src/naurng.h ${srcdir}/src/gutils.h \
  ${srcdir}/src/naugroup.h ${srcdir}/src/nautinv.h ${srcdir}/src/schreier.h ${srcdir}/src/nautycliquer.h ${srcdir}/src/traces.h ${srcdir}/src/nauchromatic.h \
  ${srcdir}/src/naugstrings.h ${srcdir}/src/planarity.h ${srcdir}/src/nauconnect.h ${srcdir}/src/namedgraphs.h ${srcdir}/src/nautaux.h
GTOOLS=../bin/copyg ../bin/listg ../bin/labelg ../bin/dretog ../bin/amtog ../bin/geng ../bin/complg ../bin/showg ../bin/NRswitchg \
  ../bin/biplabg ../bin/addedgeg ../bin/deledgeg ../bin/countg ../bin/pickg ../bin/genrang ../bin/newedgeg ../bin/catg ../bin/genbg \
  ../bin/directg ../bin/gentreeg ../bin/genquarticg ../bin/underlyingg ../bin/assembleg ../bin/gengL ../bin/addptg ../bin/ransubg \
  ../bin/ranlabg ../bin/multig ../bin/planarg ../bin/gentourng ../bin/linegraphg ../bin/watercluster2 ../bin/dretodot \
  ../bin/subdivideg ../bin/vcolg ../bin/delptg ../bin/cubhamg ../bin/twohamg ../bin/hamheuristic ../bin/converseg ../bin/distgraphg \
  ../bin/genposetg ../bin/nbrhoodg ../bin/genspecialg ../bin/edgetransg ../bin/genbgL ../bin/dreadnaut ../bin/uniqg \
  ../bin/ancestorg ../bin/productg ../bin/dimacs2g ../bin/countneg ../bin/genktreeg @shortg_or_null@
GLIBS=libnauty.la libnauty1.la libnautyS.la libnautyS1.la libnautyW.la libnautyW1.la \
  libnautyL.la libnautyL1.la @Qlibs_or_null@
TLSLIBS=libnautyT.la libnautyT1.la libnautyTS.la libnautyTS1.la libnautyTW.la \
  libnautyTW1.la libnautyTL.la libnautyTL1.la @TLSQlibs_or_null@
PCFILE=nauty.pc

# @edit_msg@

all : nautybits gtoolsbits ;

nautybits : ../bin/dreadnaut ${GLIBS} ;

gtoolsbits : ${GTOOLS} ;

NAUTYO=nauty.o nautil.o nausparse.o naugraph.o schreier.o naurng.o
NAUTY1O=nauty1.o nautil1.o nausparse.o naugraph1.o schreier.o naurng.o
