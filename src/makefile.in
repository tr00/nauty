# Test programs

testprogs : ${TESTPROGS} ${NAUTESTS} ;

checks : runchecks ;
runchecks : all nautybits gtoolsbits ../bin/naucompare ${NAUTESTS} ../bin/naucompare ${TESTPROGS}
	sh ./runalltests

check : checks ;
tests : checks ;

