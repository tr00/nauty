clean :
	rm -f ${GTOOLS} ../bin/nautyex* ../bin/callgeng2 ../bin/checks6 ../bin/bliss2dre ../bin/blisstog ../bin/showg ../bin/sumlines ../bin/testlabelling *.lo *.la tracesT.o nauty*.o nautil*.o naugraph*.o nausparse*.o \
	      naurngT.o schreier*.o nautinv*.o naututil*.o gutil1*.o gutil2*.o \
	      nautycliquer*.o nauchromatic*.o nauconnect*.o naurng.o \
	      traces.o gtools*.o gtnauty*.o naugroup*.o nautycliquer*.o \
	      .libs/* \
	      ${NAUTESTS} ../bin/naucompare nauty*.a ${TESTPROGS}

