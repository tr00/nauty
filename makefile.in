# @configure_input@
# Dispatch all requested goals in one submake, preserving its dependency graph.
SHELL=@SHELL@
goals := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),all)
build_goals := $(patsubst distclean,clean,$(patsubst build/%,%,$(patsubst bin/%,../bin/%,$(goals))))

$(goals): forward ;

forward:
	+$(MAKE) -C build $(build_goals)
	$(if $(filter distclean,$(goals)),rm -rf build bin/.libs; rm -f makefile config.log config.cache config.status libtool,:)

.PHONY: $(goals) forward
